      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "loan",
              "name": "loanId",
              "value": "={{ $json.loanId }}",
              "type": "string"
            },
            {
              "id": "key",
              "name": "reminderKey",
              "value": "={{ $json.reminderKey }}",
              "type": "string"
