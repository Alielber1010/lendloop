      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "content": "## Request notification\nConvex calls this when a borrow request is created or changes status. The webhook rejects tokens not signed with the Convex→n8n key; we then check the signed body hash, issuer, audience and that jti = eventId. The message uses only first name + initial, tool name and dates. Delivery is mocked as an upsert into lendloop_outbox (keyed by eventId, so retries never duplicate), then confirmed to Convex, which puts it in the recipient's in-app inbox.",
        "color": 5
      }
    }
