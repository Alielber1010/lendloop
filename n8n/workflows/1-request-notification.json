    {
      "id": "49a33424-0773-4d09-86d4-96d5eabde73a",
      "name": "Body matches signature?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.receivedSha256 }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $json.payload.bodySha256 }}"
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.payload.iss }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "lendloop-convex"
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.payload.aud }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "lendloop-n8n"
            },
            {
              "id": "c4",
              "leftValue": "={{ $json.payload.jti }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $('Loan event from Convex').item.json.body.eventId }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
