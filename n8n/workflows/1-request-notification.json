              "type": "string"
            },
            {
              "id": "channel",
              "name": "channel",
              "value": "in-app",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{ (() => { const b = $('Loan event from Convex').item.json.body; const d = (s) => DateTime.fromISO(s).toFormat('LLL d'); const range = d(b.loan.startDate) + '–' + d(b.loan.endDate); return ({ 'loan.requested': b.counterpart.name + ' asked to borrow your ' + b.tool.name + ' (' + range + ').', 'loan.approved': 'Good news: ' + b.counterpart.name + ' approved your request for the ' + b.tool.name + ' (' + range + ').', 'loan.declined': 'Your request for the ' + b.tool.name + ' (' + range + ') was declined.', 'loan.cancelled': b.counterpart.name + ' cancelled their request for your ' + b.tool.name + '.', 'loan.returned': 'Thanks! ' + b.counterpart.name + ' confirmed the ' + b.tool.name + ' is back.' })[b.type] ?? ('Update on the ' + b.tool.name + '.'); })() }}",
              "type": "string"
            }
          ]
        }
      }
    },
