      ],
      "parameters": {
        "content": "## LendLoop error handler\nSet as the error workflow of every LendLoop workflow. Each failed production run is logged in the n8n data table lendloop_errors and reported (signed) to Convex, where it shows on the LendLoop Admin page. Nothing fails silently.",
        "color": 3
      }
    }
