  "name": "LendLoop – Error handler",
  "description": "Error workflow for all LendLoop workflows: logs failed runs to the lendloop_errors data table and reports them (signed) to Convex for the admin page.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "9f7ac13e-8767-4ad5-a54c-4c664e489093",
      "name": "When a LendLoop workflow fails",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "ce490cf4-ac6b-4f21-86ce-a11485ef123a",
      "name": "Summarize failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "exec",
              "name": "executionId",
              "value": "={{ String($json.execution?.id ?? $json.trigger?.error?.timestamp ?? $now.toMillis()) }}",
              "type": "string"
            },
            {
              "id": "wf",
              "name": "workflow",
              "value": "={{ $json.workflow?.name ?? \"unknown workflow\" }}",
              "type": "string"
            },
            {
              "id": "node",
              "name": "node",
              "value": "={{ $json.execution?.lastNodeExecuted ?? $json.trigger?.error?.node?.name ?? \"trigger\" }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "message",
              "value": "={{ ($json.execution?.error?.message ?? $json.trigger?.error?.message ?? \"Unknown error\").slice(0, 500) }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "ba5b47ef-94f5-40f4-94da-20cca64f64d7",
      "name": "Log to lendloop_errors",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
