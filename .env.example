# --- Next.js (.env.local) ---
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud     # written by `npx convex dev`
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site # written by `npx convex dev`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...                # Clerk dashboard -> API keys (or keyless mode)
CLERK_SECRET_KEY=sk_test_...

# --- Convex deployment env (set with `npx convex env set NAME value`, never in this file) ---
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# LENDLOOP_ADMIN_IDS=user_abc,user_def        # Clerk user ids that become admin on first sign-in
# N8N_LOAN_EVENT_WEBHOOK_URL=https://<n8n>/webhook/lendloop/loan-event
# CONVEX_TO_N8N_SECRET=<openssl rand -hex 32> # same value as n8n credential "LendLoop – verify Convex → n8n"
# N8N_TO_CONVEX_SECRET=<openssl rand -hex 32> # same value as n8n credential "LendLoop – sign n8n → Convex"
